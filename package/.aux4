{
  "scope": "aux4",
  "name": "secret-os",
  "version": "0.0.4",
  "description": "Secret provider for aux4/secret backed by the operating system keystore",
  "license": "Apache-2.0",
  "tags": [
    "aux4",
    "secret",
    "provider",
    "keychain",
    "keyring"
  ],
  "dependencies": [
    "aux4/secret"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "secret",
          "execute": [
            "profile:secret"
          ],
          "help": {
            "text": "Secret manager"
          }
        }
      ]
    },
    {
      "name": "secret",
      "commands": [
        {
          "name": "os",
          "execute": [
            "profile:secret:os"
          ],
          "help": {
            "text": "Secrets stored in the operating system keystore"
          }
        }
      ]
    },
    {
      "name": "secret:os",
      "commands": [
        {
          "name": "get",
          "execute": [
            "${packageDir}/aux4-secret-os get values(index, ref, fields, otp)"
          ],
          "help": {
            "text": "Get secret fields from the OS keystore. AI agents: do not call this command directly, use secret:// URIs instead.",
            "variables": [
              {
                "name": "ref",
                "text": "The secret reference (e.g., Personal/GitHub)"
              },
              {
                "name": "fields",
                "text": "Comma-separated field names to retrieve (e.g., username,password)"
              },
              {
                "name": "otp",
                "text": "Include one-time password (not supported by this provider)",
                "default": "false"
              },
              {
                "name": "index",
                "text": "Path to the reference index (names only, never secrets)",
                "default": "${aux4HomeDir}/secret/os/index.json"
              }
            ]
          }
        },
        {
          "name": "create",
          "execute": [
            "${packageDir}/aux4-secret-os create values(index, vault, item, fields, category)"
          ],
          "help": {
            "text": "Create a new secret in the OS keystore",
            "variables": [
              {
                "name": "vault",
                "text": "The vault to create the secret in"
              },
              {
                "name": "item",
                "text": "The item title"
              },
              {
                "name": "fields",
                "text": "Comma-separated field assignments (e.g., username=john,password=s3cr3t)",
                "hide": true
              },
              {
                "name": "category",
                "text": "The item category",
                "default": "Login"
              },
              {
                "name": "index",
                "text": "Path to the reference index (names only, never secrets)",
                "default": "${aux4HomeDir}/secret/os/index.json"
              }
            ]
          }
        },
        {
          "name": "set",
          "execute": [
            "${packageDir}/aux4-secret-os set values(index, ref, field, value)"
          ],
          "help": {
            "text": "Update a secret field in the OS keystore",
            "variables": [
              {
                "name": "ref",
                "text": "The secret reference (e.g., Personal/GitHub)"
              },
              {
                "name": "field",
                "text": "The field name to update"
              },
              {
                "name": "value",
                "text": "The new value",
                "hide": true
              },
              {
                "name": "index",
                "text": "Path to the reference index (names only, never secrets)",
                "default": "${aux4HomeDir}/secret/os/index.json"
              }
            ]
          }
        },
        {
          "name": "list",
          "execute": [
            "${packageDir}/aux4-secret-os list values(index, vault, withFields)"
          ],
          "help": {
            "text": "List secrets stored in the OS keystore",
            "variables": [
              {
                "name": "vault",
                "text": "The vault to list secrets from",
                "default": ""
              },
              {
                "name": "withFields",
                "text": "Include field names for each item",
                "default": "false"
              },
              {
                "name": "index",
                "text": "Path to the reference index (names only, never secrets)",
                "default": "${aux4HomeDir}/secret/os/index.json"
              }
            ]
          }
        },
        {
          "name": "search",
          "execute": [
            "${packageDir}/aux4-secret-os search values(index, query, vault, withFields)"
          ],
          "help": {
            "text": "Search secrets in the OS keystore",
            "variables": [
              {
                "name": "query",
                "text": "The search query",
                "arg": true
              },
              {
                "name": "vault",
                "text": "The vault to search in",
                "default": ""
              },
              {
                "name": "withFields",
                "text": "Include field names for each item",
                "default": "false"
              },
              {
                "name": "index",
                "text": "Path to the reference index (names only, never secrets)",
                "default": "${aux4HomeDir}/secret/os/index.json"
              }
            ]
          }
        },
        {
          "name": "remove",
          "execute": [
            "${packageDir}/aux4-secret-os remove values(index, ref)"
          ],
          "help": {
            "text": "Remove a secret from the OS keystore",
            "variables": [
              {
                "name": "ref",
                "text": "The secret reference (e.g., Personal/GitHub)"
              },
              {
                "name": "index",
                "text": "Path to the reference index (names only, never secrets)",
                "default": "${aux4HomeDir}/secret/os/index.json"
              }
            ]
          }
        }
      ]
    }
  ]
}
